# ── Traefik (compose profile + routing) ───────────────────────────────
WEBSITE_NAME=idem-stats-web
DOMAIN_WEBSITE=idem.docker.localhost
ENTRYPOINT=web

# ── App ───────────────────────────────────────────────────────────────
# URL de l'API consommée par Vite. En dev avec les 2 stacks sur la même machine :
VITE_API_BASE_URL=http://api.idem.docker.localhost
# En prod, mets l'URL HTTPS publique :
# VITE_API_BASE_URL=https://api.idem.example.com
